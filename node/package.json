{
  "name": "backend-security-lab-express",
  "version": "1.0.0",
  "private": true,
  "description": "백엔드 개발자를 위한 서버 보안 실무 — Express 5 예제 서비스 (로컬 실습 전용)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "DATA_BACKEND=memory node --watch src/server.js",
    "dev:lab": "DATA_BACKEND=memory LAB_MODE=vulnerable HOST=127.0.0.1 node --watch src/server.js",
    "db:push": "prisma db push",
    "prisma:generate": "prisma generate",
    "test": "NODE_OPTIONS=\"--experimental-vm-modules --disable-warning=ExperimentalWarning\" jest",
    "lint": "eslint .",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@aws-sdk/client-kms": "3.1148.0",
    "@aws-sdk/client-secrets-manager": "3.1148.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@simplewebauthn/server": "14.0.3",
    "argon2": "0.45.1",
    "bcryptjs": "3.0.3",
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "dompurify": "3.4.17",
    "ejs": "7.0.1",
    "express": "5.3.0",
    "express-rate-limit": "8.7.1",
    "express-session": "1.19.0",
    "file-type": "22.2.0",
    "helmet": "8.3.0",
    "jsdom": "30.1.3",
    "jsonwebtoken": "9.0.3",
    "mongodb": "7.7.0",
    "multer": "2.5.0",
    "openid-client": "6.8.8",
    "pg": "8.23.1",
    "pg-mem": "3.0.14",
    "prisma": "7.10.1",
    "rate-limit-redis": "6.0.1",
    "redis": "6.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "jest": "30.5.2",
    "supertest": "7.3.1"
  },
  "jest": {
    "testEnvironment": "node",
    "transform": {},
    "testMatch": [
      "**/tests/**/*.test.js"
    ]
  }
}
