# 실습용 예시 값입니다. 진짜 비밀은 여기에 두지 마세요.
HOST=127.0.0.1
PORT=3000
# off(기본) | vulnerable — vulnerable 은 HOST=127.0.0.1 에서만 시작됩니다
LAB_MODE=
# db(기본: PostgreSQL + MongoDB) | memory(DB 없이 실행)
DATA_BACKEND=db
DATABASE_URL=postgresql://lab:lab-only-password@localhost:5432/express_board
MONGO_URL=mongodb://localhost:27017
MONGO_DB=express_lab
WEBHOOK_SECRET=whsec_lab_only_example
PREVIEW_ALLOWED_HOSTS=news.example.com,blog.example.com
RATE_LIMIT_PER_MIN=100
# 4-4 요청 제한 카운터를 Redis 로 공유 (비우면 서버별 메모리). REDIS_URL 이 아니라 전용 이름
RATE_LIMIT_REDIS_URL=
# 4-4 프록시 신뢰: false(기본, 프록시 없음) | 1(로드밸런서 한 단계 뒤) | IP·서브넷 목록
TRUST_PROXY=false
# 4-5 CORS·CSRF 허용 출처 (쉼표 구분). 쿠키를 쓰므로 * 금지
CORS_ORIGINS=https://app.example.com
LOG_LEVEL=info
# 취약 실습(/lab/me)에서 "유출된 비밀키" 역할
LAB_JWT_SECRET=change-me
# 5-1 내부 API 를 사내 CA 로만 검증해 호출 (둘 다 있을 때만 클라이언트 생성)
INTERNAL_API_URL=
INTERNAL_CA_FILE=
# 5-2 봉투 암호화 KMS 키 (비우면 프로세스 안의 가짜 KMS — 실습 전용). 블라인드 인덱스 키는 따로
KMS_KEY_ID=
PHONE_INDEX_KEY=phone-index-key-EXAMPLE-only-change-me
# 5-3 시크릿 소스: env(기본) | aws (Secrets Manager: prod/board-api/db · prod/board-api/webhook)
SECRETS_SOURCE=env
SECRETS_PREFIX=prod/board-api
# 5-4 개인정보 접속기록 파일(append only) · 파기 배치 보존 기간(일)
PRIVACY_AUDIT_FILE=data/audit/privacy-access.jsonl
MEMBER_RETENTION_DAYS=30
ORDER_RETENTION_DAYS=1825
# 5-5 관리자 내보내기 누적 알림 기준(건/일)
EXPORT_ALERT_THRESHOLD=10000
# 5-7 JWT 를 KMS 비대칭 키로 서명 (KMS_KEY_ID 도 필요)
JWT_KMS_KEY_ID=
